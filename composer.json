{
    "name": "rapira/testing",
    "description": "Testing utilities for rapira: provisions the server binary and runs a live server around your tests",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "rapira",
        "testo",
        "testing",
        "server",
        "worker"
    ],
    "homepage": "https://github.com/rapira-rs/testing-php",
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/log": "^2.0 || ^3.0",
        "internal/dload": "^1.14",
        "internal/path": "^1.3",
        "testo/testo": "^0.10.42"
    },
    "autoload": {
        "psr-4": {
            "Rapira\\Sdk\\Testing\\": "src/",
            "Rapira\\Sdk\\Common\\": "src/Common/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    }
}
